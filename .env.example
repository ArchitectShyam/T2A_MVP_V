# ---------------------------------------------------------------------------
# LifeOS environment variables. Copy to `.env` (and `apps/web/.env.local`) and fill in.
# ---------------------------------------------------------------------------

# Postgres connection string.
# IMPORTANT: use the Supabase *Supavisor transaction pooler* on port 6543,
# NOT the direct 5432 connection. The pooler is required for serverless
# (Vercel) runtimes so connections are multiplexed correctly.
#   Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local development with `supabase start`, use the local pooler URL it prints.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:6543/postgres"

# Public Supabase config — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"

# Server-only key. NEVER prefix with NEXT_PUBLIC_. Used only on the server for
# privileged operations (e.g. admin/storage). Do not import into client code.
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"
